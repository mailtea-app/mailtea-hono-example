# Your Mailtea API key: https://studio.mailtea.app/api-keys
MAILTEA_API_KEY=mt_pat_your_api_key_here

# The From address every send uses. It must be on a domain you have verified.
MAILTEA_FROM="Acme <hello@acme.com>"

# Only for local dev or a self-hosted Mailtea. Leave unset in production.
# MAILTEA_API_BASE_URL=http://localhost:7787

# Port the Node server listens on. Defaults to 3000.
# PORT=3000
